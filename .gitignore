# ==============================================================================
# OxideSwarm Comprehensive .gitignore
# Production-grade configuration for Rust, Android, Multi-Platform & Toolchains
# ==============================================================================

# --- Rust & Cargo ---
/target/
target/
**/*.rs.bk
*.pdb

# --- OxideSwarm Runtime, Logs & Ephemeral Files ---
*.log
**/*.log
ticket.txt
*.ticket
*.port
master.port
oxideswarm.port
/.agents/
/scratch/
**/scratch/

# --- macOS System Files ---
.DS_Store
**/.DS_Store
.AppleDouble
**/.AppleDouble
.LSOverride
Icon?
._*
**/._*
.Spotlight-V100
.Trashes

# --- Windows System Files ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp

# --- Linux & Editor Backups ---
*~
*.swp
*.swo
*.bak

# --- Android, Gradle & NDK ---
.gradle/
**/.gradle/
**/build/
build/
local.properties
*.apk
*.ap_
*.aab
*.dex
*.class
captures/
.externalNativeBuild/
.cxx/

# --- IDEs & Code Editors ---
# JetBrains / Android Studio
.idea/
*.iml
*.iws
*.ipr
out/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Xcode
*.moved-aside
*.xcuserstate
xcuserdata/

# --- Python & Testing Scratch ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.venv/
venv/
ENV/
env/

# --- Test Empirical Results & Dumps ---
tests/empirical_results.json
tests/m7_challenger_2_results.json
tests/*_results.json
windows/*.log

# >>> smart-drive managed (do not edit inside) >>>
# Base patterns (exFAT, OS metadata, agent scratch, secrets, runtime)
._*
.DS_Store
.AppleDouble/
.Spotlight-V100/
.Trashes
.fseventsd/
.TemporaryItems/
.DocumentRevisions-V100/
.VolumeIcon.icns
.apdisk
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
System Volume Information/
.Trash-*/
*~
*.log
*.tmp
*.bak
*.swp
*.swo
**/.agents/*
!**/.agents/skills/
!**/.agents/workflows/
!**/.agents/rules/
.claude/settings.local.json
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
credentials*.json
.smart_drive/
node_modules/

