    "tests": [
      {
        "label": "double_quote",
        "input": "hello\"world",
        "expected": "hello&quot;world",
        "actual": "hello&quot;world",
        "passed": true
      },
      {
        "label": "single_quote",
        "input": "hello'world",
        "expected": "hello&#039;world",
        "actual": "hello&#039;world",
        "passed": true
      },
      {
        "label": "ampersand",
        "input": "foo&bar",
        "expected": "foo&amp;bar",
        "actual": "foo&amp;bar",
        "passed": true
      },
      {
        "label": "angle_brackets",
        "input": "<script>alert(1)</script>",
        "expected": "&lt;script&gt;alert(1)&lt;/script&gt;",
        "actual": "&lt;script&gt;alert(1)&lt;/script&gt;",
        "passed": true
      },
      {
        "label": "attribute_injection",
        "input": "test\" onmouseover=\"alert(1)\"",
        "expected": "test&quot; onmouseover=&quot;alert(1)&quot;",
        "actual": "test&quot; onmouseover=&quot;alert(1)&quot;",
        "passed": true
      },
      {
        "label": "single_attr_breakout",
        "input": "test' onclick='evil()'",
        "expected": "test&#039; onclick=&#039;evil()&#039;",
        "actual": "test&#039; onclick=&#039;evil()&#039;",
        "passed": true
      }
    ]
  }
